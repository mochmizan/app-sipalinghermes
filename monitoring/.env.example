# Mizan monitoring stack environment overrides. Copy to monitoring/.env before deploy.
# .env is gitignored at repo root (.env.* rule) — never commit real values.

# Grafana admin login. OVERRIDE the password before exposing anything publicly.
GF_ADMIN_USER=mizan
GF_ADMIN_PASSWORD=change-me

# Server-side PostHog key for the Hermes app container. MUST be the `phc_`
# ingest key (same project as the browser snippet) — NEVER the `phx_`
# personal key (Query API only; ingestion silently fails with it).
POSTHOG_API_KEY=phc_placeholder

# Slack gateway bearer token for Alertmanager (get from Rico).
# Empty/unset = alerts queue in Alertmanager but delivery fails closed.
ALERTMANAGER_API_KEY=

# Hermes agent LLM (OpenAI-compatible provider). Compose interpolates these into
# the mizan-app container. API key is a SECRET: it belongs in monitoring/.env on
# the VPS (chmod 600) only — never in git, never in this file.
# Empty key = agent runtime status `unconfig` + chat 503 `llm_unconfigured` by
# design (no fallback model), so leaving it blank is a valid, honest state.
HERMES_LLM_API_KEY=
# Default `https://kenari.id/v1` when unset.
HERMES_LLM_BASE_URL=
# Default `deepseek-v4-1-flash` when unset.
HERMES_LLM_MODEL=
# Launch state: '1' (or unset) = demo accounts seeded (private beta); '0' = public launch
# (demo seeding skipped, existing @demo.hermes users purged at boot, /api/auth/demo off)
HERMES_DEMO_ACCOUNTS=1
