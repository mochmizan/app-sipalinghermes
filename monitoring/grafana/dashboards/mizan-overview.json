    {
      "id": 14,
      "type": "table",
      "title": "Waitinglist funnel, 7d (PostHog)",
      "description": "FunnelsQuery: waitinglist_submit_success → playbook_download → referral_copied. Empty until traffic flows.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "mizan-posthog"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "https://app.posthog.com/api/projects/656630/query/",
          "url_options": {
            "method": "POST",
            "data": "{\"query\":{\"kind\":\"FunnelsQuery\",\"dateRange\":{\"date_from\":\"-7d\"},\"series\":[{\"kind\":\"EventsNode\",\"event\":\"waitinglist_submit_success\"},{\"kind\":\"EventsNode\",\"event\":\"playbook_download\"},{\"kind\":\"EventsNode\",\"event\":\"referral_copied\"}]},\"name\":\"ph-wl-funnel\"}"
          },
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "mizan-posthog"
          },
          "parser": "backend",
          "root_selector": "results",
          "columns": [
            {
