    {
      "id": 200,
      "type": "row",
      "title": "Host (node-exporter)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Host CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "cpu%"
        }
      ]
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Host memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "mem%"
        }
      ]
    },
    {
      "id": 8,
      "type": "gauge",
      "title": "Root disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "mizan-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "targets": [
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})",
          "legendFormat": "disk%"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Targets Health",
      "gridPos": {
        "h": 1,
        "w": 24,
