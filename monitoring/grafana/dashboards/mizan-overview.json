    {
      "id": 400,
      "type": "row",
      "title": "PostHog product analytics (live via Query API)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false,
      "datasource": null,
      "targets": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "PostHog event volume",
      "description": "Hourly event counts from PostHog Query API; follows dashboard time range.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "mizan-posthog"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "https://app.posthog.com/api/projects/656630/query/",
          "url_options": {
            "method": "POST",
            "data": "{\"query\":{\"kind\":\"HogQLQuery\",\"query\":\"SELECT toStartOfHour(timestamp) AS t, count() AS c FROM events WHERE timestamp >= '${__timeFrom:date:iso}' AND timestamp <= '${__timeTo:date:iso}' GROUP BY t ORDER BY t\"},\"name\":\"ph-event-volume\"}"
          },
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "mizan-posthog"
          },
          "parser": "backend",
          "root_selector": "results",
          "columns": [
            {
              "selector": "0",
              "text": "time",
              "type": "string"
            },
            {
              "selector": "1",
              "text": "count",
              "type": "number"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "time",
                "destinationType": "time"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Waitinglist submits (PostHog)",
      "description": "Count of waitinglist_submit_success in dashboard range.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
